[Unit]
Description=uni4 keyboard backlight colour
After=systemd-modules-load.service

[Service]
Type=oneshot
ExecStartPre=/bin/sh -c 'modprobe acpi_call 2>/dev/null || true'
# Edit the RGB values below (0-255).
ExecStart=/usr/local/bin/uni4 kbd color 0 255 255
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
